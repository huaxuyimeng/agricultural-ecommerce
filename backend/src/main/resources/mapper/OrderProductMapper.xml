<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.vuehouduan.mapper.OrderProductMapper">

    <resultMap id="BaseResultMap" type="com.example.vuehouduan.entity.OrderProduct">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="product_id" property="productId"/>
        <result column="product_name" property="productName"/>
        <result column="product_image" property="productImage"/>
        <result column="price" property="price"/>
        <result column="quantity" property="quantity"/>
        <result column="total_price" property="totalPrice"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, order_id, product_id, product_name, product_image, price, quantity, total_price, create_time
    </sql>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM order_products WHERE order_id = #{orderId}
    </select>

    <select id="selectByProductId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM order_products WHERE product_id = #{productId}
    </select>

    <select id="selectByOrderIdAndProductId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM order_products
        WHERE order_id = #{orderId} AND product_id = #{productId}
    </select>

    <delete id="deleteByOrderId">
        DELETE FROM order_products WHERE order_id = #{orderId}
    </delete>

    <delete id="deleteByProductId">
        DELETE FROM order_products WHERE product_id = #{productId}
    </delete>

    <insert id="insertBatch">
        INSERT INTO order_products (order_id, product_id, product_name, product_image, price, quantity, total_price, create_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.orderId}, #{item.productId}, #{item.productName}, #{item.productImage},
             #{item.price}, #{item.quantity}, #{item.totalPrice}, NOW())
        </foreach>
    </insert>

    <select id="countByOrderId" resultType="int">
        SELECT COUNT(*) FROM order_products WHERE order_id = #{orderId}
    </select>

    <select id="countByProductId" resultType="int">
        SELECT COUNT(*) FROM order_products WHERE product_id = #{productId}
    </select>

</mapper>